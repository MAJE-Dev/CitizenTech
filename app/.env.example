# Tudo aqui é opcional: o app roda sem .env.
# Nao coloque chaves ou senhas: o app nao usa nenhum servico que exija chave.

# URL do JSON com as ocorrencias de exemplo.
# Se ficar vazio, o app usa o arquivo app/mock/ocorrencias.json do repositorio no GitHub.
EXPO_PUBLIC_API_URL=

# Endereco das imagens do mapa (padrao {z}/{x}/{y}).
# Se ficar vazio, o app usa o CARTO Positron: https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png
# Alternativa: OpenStreetMap puro: https://tile.openstreetmap.org/{z}/{x}/{y}.png
EXPO_PUBLIC_MAPA_TILES=
